TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/finops_ai_test

API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

UPLOAD_MAX_BYTES=209715200
UPLOAD_ALLOWED_EXTENSIONS=.csv,.parquet,.csv.gz
UPLOAD_DECOMPRESSION_MAX_RATIO=10
UPLOAD_DECOMPRESSION_MAX_BYTES=2147483648
UPLOAD_STAGING_DIR=./data/incoming

WORKER_HEARTBEAT_SECONDS=5
WORKER_ORPHAN_TIMEOUT_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_REAPER_POLL_SECONDS=5
WORKER_POLL_SECONDS=1

